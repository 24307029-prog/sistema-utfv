const mongoose = require('mongoose');

const materiaCatalogoSchema = new mongoose.Schema({
  clave: { type: String, required: true, unique: true, uppercase: true },
  nombre: { type: String, required: true },
  profesor: { type: String, required: true },
  cuatrimestre: { type: String, required: true }
});

module.exports = mongoose.model('MateriaCatalogo', materiaCatalogoSchema);